{
  "name": "@descope/poppy-agent",
  "version": "1.0.0",
  "description": "TypeScript Personal Agent SDK for the Personal Agent Protocol (Poppy) 1.0, 0.4 and 0.3: version selection, discovery, delegated Session JWTs, Direct, Device and Mediated Sign-In, APIs, browser join, conversations, task coverage and operations.",
  "keywords": [
    "agent",
    "agents",
    "dpop",
    "mcp",
    "oauth",
    "personal-agent",
    "personal-agent-protocol",
    "poppy",
    "sdk"
  ],
  "homepage": "https://github.com/descope/poppy-agent#readme",
  "bugs": {
    "url": "https://github.com/descope/poppy-agent/issues"
  },
  "license": "Apache-2.0",
  "author": "Descope",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/descope/poppy-agent.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "ai": "7.0.163",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.8"
}
